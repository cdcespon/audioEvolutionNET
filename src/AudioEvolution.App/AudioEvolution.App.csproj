<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows-only on purpose: the product target is a Windows DAW, not a cross-platform
      MAUI app, and MAUI's Windows head (WinUI3) can only be built/run on Windows itself —
      this project cannot be restored or built in this repo's Linux dev container.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AudioEvolution.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Audio Evolution</ApplicationTitle>
    <ApplicationId>com.audioevolution.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1b1b1f" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1b1b1f" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioEvolution.Core\AudioEvolution.Core.csproj" />
    <ProjectReference Include="..\AudioEvolution.Data\AudioEvolution.Data.csproj" />
  </ItemGroup>

</Project>
